# GeologyByMass: the texts of its OMS tab, in English. Godot shows English for any language without its own file
# (its fallback locale), so another language only needs a copy of this file with its Language and msgstr lines
# translated, loaded in ModMain.gd.
msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "GEOLOGYBYMASS_TAB"
msgstr "GBM"

msgid "GEOLOGYBYMASS_ENABLED"
msgstr "Judge ore by mineral mass instead of the Geologist tab's switches and minimum value"

msgid "GEOLOGYBYMASS_HINT"
msgstr ""
"GeologyByMass mod: while this is on, an identified chunk passes every row of the Geologist tab when it holds at "
"least the mass set below for a mineral switched on here. The rows' own mineral switches and minimum values no longer "
"count, nor does the chunk's value. The rows decide which chunks keep a full info box, and which ones the arm and the "
"drones go for."

msgid "GEOLOGYBYMASS_MINERAL_SWITCH"
msgstr "Count this mineral: a chunk with at least its mass passes every row of the Geologist tab."

msgid "GEOLOGYBYMASS_MIN_MASS"
msgstr "Least mass of this mineral, as your geologist estimates it, for a chunk to pass while its switch is on."

msgid "GEOLOGYBYMASS_NO_GEOLOGIST"
msgstr "WARNING: No Geologist on board. The values above will have no effect."
