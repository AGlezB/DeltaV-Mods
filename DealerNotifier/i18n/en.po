# DealerNotifier: its texts, in English. Godot shows English for any language without its own file (its fallback
# locale), so another language only needs a copy of this file with its Language and msgstr lines translated, loaded in
# ModMain.gd. Keep each %s: the code fills them in.
msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

# The station menu's Dealer entry while a ship you watch is new at the dealer; %s is the entry's own text.
msgid "DEALERNOTIFIER_ALERT"
msgstr "%s (*)"

# The Dealer entry's tooltip; the first %s is the key to hold while clicking, the second the mod's name.
msgid "DEALERNOTIFIER_SETTINGS_TOOLTIP"
msgstr "Click while pressing %s to open the %s settings."

# The settings screen: the title of the group above the ships, and its switches, for the ships the Dealer marks new and
# for the others.
msgid "DEALERNOTIFIER_CONDITION"
msgstr "Condition"

msgid "DEALERNOTIFIER_NEW"
msgstr "New"

msgid "DEALERNOTIFIER_USED"
msgstr "Used"

# The settings screen: the tooltip of every ship's switch.
msgid "DEALERNOTIFIER_WATCHED"
msgstr "Mark Dealer when this ship comes up for sale"

# The title of the group of the ships whose series has no other ship in the list.
msgid "DEALERNOTIFIER_OTHERS"
msgstr "Others"

# The settings screen: the buttons under the ships, which switch every switch on the screen on, or off.
msgid "DEALERNOTIFIER_SELECT_ALL"
msgstr "Select all"

msgid "DEALERNOTIFIER_SELECT_NONE"
msgstr "Select none"

# The tooltip of the badge on a Dealer screen entry.
msgid "DEALERNOTIFIER_BADGE_TOOLTIP"
msgstr "New since you last opened Dealer, and a ship you are watching."
