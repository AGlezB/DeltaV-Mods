; Test harness for the mods (see run.ps1). Not a mod, and not run from here: run.ps1 assembles the project in
; <TempDir>\tests\project from these sources plus the game's own scripts (ships/, vendor/, Tool.gd, Boot.gd,
; copied from the decompiled game, never committed) and the mods packaged as zips.
; The autoloads keep the game's order (its project.godot); ModLoader is the harness's own mod loader, loader.gd.

config_version=4

[application]

config/name="dV mod tests"
run/main_scene="res://main.tscn"

[autoload]

Tool="*res://Tool.gd"
Debug="*res://harness/stubs/Debug.gd"
ModLoader="*res://harness/loader.gd"
Settings="*res://harness/stubs/Settings.gd"
Loader="*res://harness/stubs/Loader.gd"
Namer="*res://harness/stubs/Namer.gd"
CurrentGame="*res://harness/stubs/CurrentGame.gd"

[display]

window/vsync/use_vsync=false

[logging]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false
