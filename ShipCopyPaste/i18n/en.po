# ShipCopyPaste: the texts of its Fleet screen buttons and confirmation dialog, in English. Godot shows English for any
# language without its own file (its fallback locale), so another language only needs a copy of this file with its
# Language and msgstr lines translated, loaded in ModMain.gd.
msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "SHIPCOPYPASTE_COPY"
msgstr "Copy this ship's setup onto the ship you fly: its settings, crew and equipment, as you choose"

msgid "SHIPCOPYPASTE_COPY_MODEL"
msgstr "Not the same model as the ship you fly, so it can't be copied onto it"

msgid "SHIPCOPYPASTE_CONFIRM"
