msgstr "Equipment"

msgid "SHIPCOPYPASTE_SAME"
msgstr "Same"

msgid "SHIPCOPYPASTE_INCOMPATIBLE"
msgstr "Incompatible equipment"

msgid "SHIPCOPYPASTE_UNFIT"
msgstr "Not sold here"

msgid "SHIPCOPYPASTE_BULLET"
msgstr "• %s"

msgid "SHIPCOPYPASTE_COST"
msgstr "-%s E$"

msgid "SHIPCOPYPASTE_GAIN"
msgstr "+%s E$"

msgid "SHIPCOPYPASTE_TOTAL"
msgstr "Total"

